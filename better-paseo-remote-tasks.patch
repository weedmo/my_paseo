diff --git a/client/tasks/board/remote-tasks.tsx b/client/tasks/board/remote-tasks.tsx
new file mode 100644
index 00000000..0406be62
--- /dev/null
+++ b/client/tasks/board/remote-tasks.tsx
@@ -0,0 +1,51 @@
+import React, { useMemo } from "react";
+import { Pressable, ScrollView, Text, View } from "react-native";
+import { useAgent, useAgents, useHosts, type PluginScreenProps } from "@getpaseo/plugin/client";
+import type { AgentRef, PluginAgentSnapshot } from "@getpaseo/plugin";
+import { useTasksLanguage } from "../i18n";
+
+function lane(agent: PluginAgentSnapshot) {
+  if (agent.attentionReason === "permission") return "needsInput";
+  if (agent.status === "error" || agent.attentionReason === "error") return "review";
+  if (agent.status === "running" || agent.status === "initializing") return "running";
+  return agent.requiresAttention ? "review" : "done";
+}
+
+export function useRemoteTasks(hostId: string) {
+  const hosts = useHosts();
+  const query = useMemo(() => ({
+    hosts: hosts.filter(host => host.serverId !== hostId && host.status === "online").map(host => host.serverId),
+    where: (agent: PluginAgentSnapshot) => agent.hostId !== hostId && !agent.background && lane(agent) !== "done",
+    groupBy: lane,
+  }), [hosts, hostId]);
+  return { groups: useAgents(query), hosts };
+}
+
+function RemoteRow({ agent, host, screen }: { agent: AgentRef; host: string; screen: PluginScreenProps }) {
+  const title = useAgent(agent, item => item.title);
+  return <Pressable accessibilityRole="button" disabled={!screen.navigation}
+    onPress={() => screen.navigation?.openAgent({ serverId: agent.hostId, agentId: agent.id })}
+    style={{ paddingVertical: 5 }}>
+    <Text style={{ color: screen.theme.colors.foreground }}>{host} · {title || agent.id}</Text>
+  </Pressable>;
+}
+
+export function RemoteTasks({ screen }: { screen: PluginScreenProps }) {
+  const { groups, hosts } = useRemoteTasks(screen.host.id);
+  const zh = useTasksLanguage() === "zh";
+  const labels: Record<string, string> = zh
+    ? { running: "运行中", needsInput: "待输入", review: "待查看" }
+    : { running: "Running", needsInput: "Needs input", review: "Review" };
+  if (!groups.length) return null;
+  return <View style={{ maxHeight: "30%", paddingHorizontal: 12, paddingVertical: 5 }}>
+    <ScrollView nestedScrollEnabled>
+      {groups.map(group => <View key={group.key}>
+        <Text style={{ color: screen.theme.colors.foreground, fontWeight: "600" }}>
+          {zh ? "远程" : "Remote"} · {labels[group.key]} ({group.items.length})
+        </Text>
+        {group.items.map(agent => <RemoteRow key={agent.key} agent={agent} screen={screen}
+          host={hosts.find(host => host.serverId === agent.hostId)?.label || agent.hostId} />)}
+      </View>)}
+    </ScrollView>
+  </View>;
+}
